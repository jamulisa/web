# Jamulisa - static site (repo: jamulisa/web, branch gh-pages)
# Deployed to the cPanel docroot at ftp.elitepremier.com.my
#
# 2026-10-01: WordPress decommissioned. A full backup of the removed install
# (files, uploads, wp-config, page content, .htaccess) is kept on the deploy
# host at ~/jamulisa-wp-backup/. The WordPress database was NOT dropped by
# this change - do that from cPanel separately.

# Only index.html is a valid directory index now that index.php is gone.
DirectoryIndex index.html

# Stop exposing the image/asset directories as browsable listings.
Options -Indexes


# --- Attribution short links: social channel -> WhatsApp, with a source tag ---
# Definitions live in the mod_rewrite block below: each short URL goes through
# go.php, which logs the click and then 302s to wa.me with the source tag.

<IfModule mod_rewrite.c>
RewriteEngine On
RewriteBase /

# --- Attribution short links: social channel -> go.php -> WhatsApp (tagged) ---
# The hit goes through go.php so the click is counted BEFORE the 302 to wa.me,
# and the pre-filled message names the channel, so the enquiry itself carries
# the source. Do NOT convert these back to mod_alias Redirect: that bypasses
# go.php and the click is never logged. Short links belong in each profile's
# BIO (Threads/IG ban URLs in captions); Facebook captions can carry /fb.
RewriteRule ^fb/?$      /go.php?c=fb     [L]
RewriteRule ^ig/?$      /go.php?c=ig     [L]
RewriteRule ^th/?$      /go.php?c=th     [L]
RewriteRule ^status/?$  /go.php?c=status [L]
RewriteRule ^tt/?$      /go.php?c=tt     [L]
RewriteRule ^yt/?$      /go.php?c=yt     [L]
RewriteRule ^gbp/?$     /go.php?c=gbp    [L]

# --- Canonical legal URLs: serve at /terms-of-service and /privacy-policy ---
# Internal rewrite (no R flag) so the URL reviewers/platforms are given is the
# one that answers 200, not a 301 hop. Each .html carries a matching canonical.
# NOTE: /privacy-policy used to 301 to / here (WordPress-era page retired); it
# is a real page again, so that legacy redirect must NOT be reinstated.
RewriteRule ^terms-of-service/?$ /terms-of-service.html [L]
RewriteRule ^privacy-policy/?$  /privacy-policy.html  [L]

# --- Legacy WordPress permalinks -> static equivalents (301, permanent) ---
RewriteRule ^testimoni/?$      /testimoni.html      [R=301,L]
RewriteRule ^cara/?$           /index.html#how      [R=301,L,NE]
RewriteRule ^stokis-ejen/?$    /                    [R=301,L]

# Legacy WordPress sitemap / feeds -> the static sitemap
RewriteRule ^wp-sitemap.*\.xml$ /sitemap.xml        [R=301,L]
RewriteRule ^feed/?$            /sitemap.xml        [R=301,L]

# Canonicalise /index.html -> /
RewriteCond %{THE_REQUEST} \s/index\.html[\s?] [NC]
RewriteRule ^index\.html$ / [R=301,L]

# Any surviving WordPress path is gone for good (410, not 404 - do not retry)
RewriteRule ^wp-.*$ - [G,L]
RewriteRule ^xmlrpc\.php$ - [G,L]
RewriteRule ^readme\.html$ - [G,L]
RewriteRule ^license\.txt$ - [G,L]
</IfModule>

ErrorDocument 404 /index.html

# php -- BEGIN cPanel-generated handler, do not edit
# Set the “ea-php74” package as the default “PHP” programming language.
<IfModule mime_module>
  AddHandler application/x-httpd-ea-php74 .php .php7 .phtml
</IfModule>
# php -- END cPanel-generated handler, do not edit
